DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=mtc_site
JWT_SECRET=change-me-in-production
JWT_EXPIRES=24h
PORT=5001

# CORS - comma-separated origins, leave empty to allow all (dev mode)
ALLOWED_ORIGINS=

# Supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Firebase Admin SDK (for push notifications)
# Option 1: Paste the entire service account JSON as a single line
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
#
# Option 2: Set the path to the service account JSON file
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccountKey.json
FIREBASE_SERVICE_ACCOUNT=
GOOGLE_APPLICATION_CREDENTIALS=
