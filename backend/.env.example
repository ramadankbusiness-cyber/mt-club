DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=mtc_site
JWT_SECRET=change-me-to-a-strong-random-string
JWT_EXPIRES=24h
PORT=5001

# CORS - comma-separated allowed origins (required in production)
# Example: ALLOWED_ORIGINS=https://mt-club-seven.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=

# Supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Google OAuth (Client ID only — no secret needed for ID token verification)
GOOGLE_CLIENT_ID=

# OneSignal (from OneSignal Dashboard > Keys & IDs)
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
